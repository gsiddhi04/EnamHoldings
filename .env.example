# Copy to .env and fill in ONE key. .env is git-ignored; real environment variables override it.

# Primary provider (free tier works). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternative provider, used only if GEMINI_API_KEY is empty
# ANTHROPIC_API_KEY=

# --- optional ---
# Models: cheap tier does bulk extraction, strong tier does reasoning (see README, "Model routing")
# FINN_GEMINI_CHEAP=gemini-3.5-flash-lite
# FINN_GEMINI_STRONG=gemini-3-flash-preview

# Hosted demo: pull + enrich fresh data every N hours inside the web process
# FINN_AUTO_REFRESH_HOURS=3

# Daily cap on AI-generated answers across all visitors of a public link (default 400)
# FINN_DAILY_LLM_CAP=400

# Web Push keys for a host with a disposable disk: run `python -m backend.push` and paste its output here
# FINN_VAPID_PRIVATE=

# Where the SQLite file lives (point at a persistent disk when hosting)
# FINN_DB=data/finn.db
